# Connection string do Neon (Dashboard > Connect > Pooled connection)
DATABASE_URL="postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Chave para assinar o cookie de login (gere um texto aleatório longo)
AUTH_SECRET="gere-um-texto-aleatorio-longo"

# O login agora é por usuário individual (e-mail + senha), sem senha única compartilhada.
# Crie o primeiro admin com: npm run criar-usuario -- "Seu Nome" voce@dominio.com senha --admin

# Avisos ao cliente (todos opcionais: sem eles só funciona o botão do WhatsApp que abre o wa.me).
# WhatsApp pela API: um POST em JSON { nome, telefone, status, motivo, data_finalizacao, evento, mensagem }
# para um webhook (n8n, Evolution API, Z-API...). O token, se houver, vai em "Authorization: Bearer".
NOTIFICACAO_WEBHOOK_URL=""
NOTIFICACAO_WEBHOOK_TOKEN=""
# E-mail transacional pelo Resend (https://resend.com): chave da API e remetente verificado.
RESEND_API_KEY=""
EMAIL_REMETENTE="Pré-Safra <avisos@seudominio.com.br>"
# Com 1, a data do agendamento mudando já avisa o cliente pelos canais configurados. Padrão: desligado.
NOTIFICACAO_AUTOMATICA="0"
