generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id              Int      @id @default(autoincrement())
  nome            String
  email           String   @unique
  senhaHash       String
  admin           Boolean  @default(false)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
  somentePainel   Boolean  @default(false)
  nomeResponsavel String?
  permissoes      String[] @default([])
}

model Safra {
  id           Int        @id @default(autoincrement())
  nome         String     @unique
  cultura      String?
  inicio       DateTime   @db.Date
  prazo        DateTime   @db.Date
  ativa        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  preSafras    PreSafra[]
}

model Cliente {
  id           Int        @id @default(autoincrement())
  nome         String     @unique
  uf           String?
  consultor    String?
  atendente    String?
  gerente      String?
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  regiao       String?
  cidade       String?
  comercial    String?
  whatsapp     String?
  email        String?
  preSafras    PreSafra[]
}

model PreSafra {
  id                    Int           @id @default(autoincrement())
  clienteId             Int?
  clienteNomeManual     String?
  responsavel           String?
  dataPrevista          DateTime?     @db.Date
  formato               Formato?
  configuradoSistema    Boolean       @default(false)
  melhoriasApresentadas Boolean       @default(false)
  observacoes           String?
  criadoEm              DateTime      @default(now())
  atualizadoEm          DateTime      @updatedAt
  inativo               Boolean       @default(false)
  observacaoConclusao   String?
  motivoInativacao      String?
  safraId               Int
  horario               String?
  agendadoEm            DateTime?
  agendadoPor           String?
  atualizadoPor         String?
  motivoPendencia       String?
  observacaoPendencia   String?
  conclusoes            Conclusao[]
  notificacoes          Notificacao[]
  cliente               Cliente?      @relation(fields: [clienteId], references: [id])
  safra                 Safra         @relation(fields: [safraId], references: [id])

  @@unique([clienteId, safraId])
  @@index([safraId])
}

model Notificacao {
  id         Int      @id @default(autoincrement())
  preSafraId Int
  canal      String
  evento     String
  destino    String
  ok         Boolean
  erro       String?
  autor      String?
  criadoEm   DateTime @default(now())
  preSafra   PreSafra @relation(fields: [preSafraId], references: [id], onDelete: Cascade)

  @@index([preSafraId, criadoEm])
}

model Atividade {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String?
  data         DateTime @db.Date
  horario      String?
  concluida    Boolean  @default(false)
  criadoPor    String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  criadoPorId  Int?

  @@index([data])
}

model Sugestao {
  id                Int             @id @default(autoincrement())
  nome              String
  whatsapp          String
  topico            String
  topicoNorm        String
  texto             String
  possivelDuplicada Boolean         @default(false)
  faqParecida       String?
  oculta            Boolean         @default(false)
  criadoEm          DateTime        @default(now())
  tipo              String          @default("faq")
  anexos            AnexoSugestao[]

  @@index([criadoEm])
  @@index([whatsapp, criadoEm])
  @@index([tipo, oculta, id])
}

model AnexoSugestao {
  id         Int      @id @default(autoincrement())
  sugestaoId Int
  nome       String
  tipo       String
  tamanho    Int
  dados      Bytes
  criadoEm   DateTime @default(now())
  sugestao   Sugestao @relation(fields: [sugestaoId], references: [id], onDelete: Cascade)

  @@index([sugestaoId])
  @@index([criadoEm])
}

model Configuracao {
  chave String @id
  valor String
}

model Conclusao {
  id               Int       @id @default(autoincrement())
  preSafraId       Int
  observacao       String?
  autor            String?
  criadoEm         DateTime  @default(now())
  reabertoEm       DateTime?
  reabertoPor      String?
  motivoReabertura String?
  preSafra         PreSafra  @relation(fields: [preSafraId], references: [id], onDelete: Cascade)

  @@index([preSafraId, criadoEm])
}

enum Formato {
  Online
  Presencial
}
