generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nome          String
  email         String   @unique
  // Formato "scrypt:N:r:p:saltHex:hashHex" — ver src/lib/senha.ts
  senhaHash     String
  admin         Boolean  @default(false)
  // Conta restrita ao Painel (ex.: TV da sala) — não vê Clientes, Novo cliente nem Admin,
  // mesmo sem ser admin. Ver exigirAcessoPainel()/exigirAcessoCompleto() em src/lib/auth.ts.
  somentePainel Boolean  @default(false)
  // Como esta pessoa aparece na lista de responsáveis dos clientes (ex.: "Maria"), escolhido por um
  // admin em Admin → Usuários. Usuário comum só altera os clientes cujo responsável é este nome;
  // vazio = só vê. Ver podeAlterarCliente() em src/lib/responsavel.ts.
  nomeResponsavel String?
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

// Um período de Pré-Safra por cultura (ex.: "Soja 2026", "Milho 2026"), com início/prazo
// próprios. Substitui o antigo campo PreSafra.anoSafra (só um ano, sem distinguir cultura).
model Safra {
  id           Int        @id @default(autoincrement())
  nome         String     @unique
  cultura      String?
  inicio       DateTime   @db.Date
  prazo        DateTime   @db.Date
  // Aparece no seletor de safra enquanto true; admin arquiva (false) em vez de apagar
  ativa        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  preSafras    PreSafra[]
}

model Cliente {
  id           Int        @id @default(autoincrement())
  nome         String     @unique
  cidade       String?
  uf           String?
  // Região de atendimento (ex.: "Norte MT a PA/RR"), vinda da planilha de clientes
  regiao       String?
  consultor    String?
  // Dupla de atendentes da região (ex.: "Maria e Jean")
  atendente    String?
  // Comercial responsável pelo cliente; vazio = vale o comercial da região (COMERCIAL_POR_REGIAO)
  comercial    String?
  gerente      String?
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  preSafras    PreSafra[]
}

enum Formato {
  Online
  Presencial
}

model PreSafra {
  id                    Int         @id @default(autoincrement())
  clienteId             Int?
  cliente               Cliente?    @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  // Preenchido só quando o cliente ainda não existe na base
  clienteNomeManual     String?
  safraId               Int
  safra                 Safra       @relation(fields: [safraId], references: [id])
  responsavel           String?
  dataPrevista          DateTime?   @db.Date
  // Horário agendado no dia da data prevista, no formato "HH:MM" (grade fixa em src/lib/horarios.ts)
  horario               String?
  formato              Formato?
  configuradoSistema    Boolean     @default(false)
  melhoriasApresentadas Boolean     @default(false)
  // Quem fez o agendamento atual e quando; nulo se foi feito antes destes campos existirem ou se
  // o cliente não está agendado. O agendamento é aberto a todos os usuários (ver src/lib/responsavel.ts).
  agendadoPor           String?
  agendadoEm            DateTime?
  // Cliente que não fará o Pré-Safra: sai da lista principal, mas pode ser reativado
  inativo               Boolean     @default(false)
  observacoes           String?
  // LEGADO: substituído pelo histórico em Conclusao. Só o script migrar-conclusoes lê este campo;
  // depois de rodá-lo, o campo pode ser removido do schema.
  observacaoConclusao   String?
  // Por que o cliente foi inativado (ex.: não fará o Pré-Safra este ano)
  motivoInativacao      String?
  criadoEm              DateTime    @default(now())
  atualizadoEm          DateTime    @updatedAt
  conclusoes            Conclusao[]

  @@unique([clienteId, safraId])
  @@index([safraId])
}

// Lançamento livre da aba Calendário (ex.: dia de enviar aviso, dia de atualizar o cliente).
// Compartilhado pela equipe toda; não depende de safra nem de cliente.
model Atividade {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String?
  data         DateTime @db.Date
  // "HH:MM" livre (qualquer minuto do dia). Nulo só em atividades lançadas antes de o horário
  // ser obrigatório.
  horario      String?
  concluida    Boolean  @default(false)
  // Nome de quem lançou, como em Conclusao.autor (só para exibição)
  criadoPor    String?
  // Dono da atividade: só ele (ou um admin) pode editar, concluir ou excluir; os demais só veem.
  // Nulo nas lançadas antes deste campo existir — nelas vale o nome (ver podeAlterarAtividade()).
  criadoPorId  Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([data])
}

// Sugestão de tema para o FAQ, enviada pelo público via QR code (rota pública /sugestao).
// A equipe entra em contato pelo WhatsApp depois para entender melhor a ideia.
model Sugestao {
  id                Int      @id @default(autoincrement())
  nome              String
  // Só dígitos, com DDI: "5566999998888" (ver src/lib/whatsapp.ts)
  whatsapp          String
  topico            String
  // Tópico sem acento/maiúscula: agrupa "Nota Fiscal" e "nota fiscal" e define a cor no telão
  topicoNorm        String
  texto             String
  // true quando o sistema achou uma pergunta parecida no FAQ, mas a pessoa insistiu em enviar
  possivelDuplicada Boolean  @default(false)
  faqParecida       String?
  // Escondida do telão pelo admin (moderação); continua na lista do admin
  oculta            Boolean  @default(false)
  criadoEm          DateTime @default(now())

  @@index([criadoEm])
  @@index([whatsapp, criadoEm])
}

// Ajustes globais editáveis pelo admin, um por linha (chave -> valor em texto).
// Chaves conhecidas e seus limites ficam em src/lib/configuracoes.ts.
model Configuracao {
  chave String @id
  valor String
}

// Uma finalização do Pré-Safra, guardada como entrada de histórico (nunca é sobrescrita).
// Cada nova finalização cria uma entrada; ao reabrir, o motivo é gravado na entrada aberta.
model Conclusao {
  id               Int       @id @default(autoincrement())
  preSafraId       Int
  preSafra         PreSafra  @relation(fields: [preSafraId], references: [id], onDelete: Cascade)
  observacao       String?
  // Nulo só nas entradas migradas do formato antigo, que não guardava o autor
  autor            String?
  criadoEm         DateTime  @default(now())
  // Preenchidos quando o cliente é reaberto; nulo enquanto a finalização estiver valendo
  reabertoEm       DateTime?
  reabertoPor      String?
  motivoReabertura String?

  @@index([preSafraId, criadoEm])
}
