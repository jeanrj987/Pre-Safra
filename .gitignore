# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env / generated
.env
.env.*
!.env.example
/src/generated

# backups da Base de Conhecimento (conteúdo de clientes; só o faq.json gerado é versionado)
/Backup*.json

# listas de clientes (dados internos; nao versionar)
/Clientes.txt
/Planilhas/
